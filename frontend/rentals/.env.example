# Base URL of the Willcoll API, as seen by the BROWSER (no /v1 suffix).
# Leave EMPTY (recommended): the app calls /v1 and /q on its own origin, and Nuxt
# proxies them to the API (see routeRules and server/routes/q/[token].get.ts in
# nuxt.config.ts / server/). This lets phones on the LAN and printed QR codes
# work, and keeps the session cookie on this origin.
# Only set this when the API is on a separate origin, which must then be listed in
# the API's CORS_TRUSTED_ORIGINS.
NUXT_PUBLIC_API_BASE=

# Base URL of the Willcoll API, as seen by the NUXT SERVER (no /v1 suffix).
# Server-only — never sent to the browser. Defaults to http://localhost:4000.
# Set this when the API isn't reachable at that address from wherever the Nuxt
# server itself runs (e.g. a separate container/host in staging or production).
NUXT_API_INTERNAL_BASE=
# Where the BROWSER reaches platform-api: sign-in, sign-up, activation, password
# reset, the account page, billing and the Super Admin's manager / subscription /
# plan pages (build-phases.txt 3i-c; the rest goes to the Rentals API above).
# Leave at the default /_platform in development: a same-origin path that Nuxt
# proxies to platform-api (routeRules in nuxt.config.ts), so the one platform
# session cookie is first-party and reaches rentals-api too. In staging /
# production set it to platform-api's public origin (e.g. https://api.willcoll.co.ke);
# that origin must list this app in platform-api's CORS_TRUSTED_ORIGINS and its
# session cookie Domain must cover both (SESSION_COOKIE_DOMAIN, ADR-0007).
NUXT_PUBLIC_API_PLATFORM_BASE=/_platform

# platform-api as seen by the NUXT SERVER (no /v1 suffix), for the /_platform
# proxy. Server-only. Defaults to http://localhost:4100.
NUXT_API_PLATFORM_INTERNAL_BASE=
