# Base URL of the Willcoll API, as seen by the BROWSER (no /v1 suffix).
# Leave EMPTY (recommended): the app calls /v1 and /q on its own origin, and Nuxt
# proxies them to the API (see routeRules and server/routes/q/[token].get.ts in
# nuxt.config.ts / server/). This lets phones on the LAN and printed QR codes
# work, and keeps the session cookie on this origin.
# Only set this when the API is on a separate origin, which must then be listed in
# the API's CORS_TRUSTED_ORIGINS.
NUXT_PUBLIC_API_BASE=

# Base URL of the Willcoll API, as seen by the NUXT SERVER (no /v1 suffix).
# Server-only — never sent to the browser. Defaults to http://localhost:4000.
# Set this when the API isn't reachable at that address from wherever the Nuxt
# server itself runs (e.g. a separate container/host in staging or production).
NUXT_API_INTERNAL_BASE=