# Production. COMMITTED WITH PLACEHOLDERS ONLY. Real values live in the
# production VPS's environment file and in CI secrets, never in git; this file
# is the checklist of what must be set. Angle-bracket values are placeholders.
#
# Anything empty falls back to the default in cmd/rentals-api/config.go. In production
# the API logs an ERROR at startup for every payment setting that is missing:
# read those lines after every deploy.

PORT=4000
ENV=production

# The API must connect as willcoll_app (RLS applies). Never point DB_DSN at the
# owner role: superusers bypass row-level security.
DB_DSN=postgres://willcoll_app:<app-password>@db:5432/willcoll?sslmode=require
MIGRATE_DSN=postgres://willcoll:<owner-password>@db:5432/willcoll?sslmode=require
DB_APP_PASSWORD=<app-password>
DB_ADMIN_PASSWORD=<admin-password>
DB_ADMIN_DSN=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m
DB_QUERY_TIMEOUT=3s

ADMIN_NAME=Willcoll Admin
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password-12-to-72-bytes>

LIMITER_RPS=2
LIMITER_BURST=4
LIMITER_ENABLED=true

# Live PayHero account. The two channels are separate: collections settle to
# landlords' bank paybills; billing is Willcoll's own subscription channel.
PAYHERO_BASE_URL=<payhero-base-url>
PAYHERO_API_KEY=<payhero-authorization-header-value>
PAYHERO_COLLECTIONS_CHANNEL_ID=<live-collections-channel>
PAYHERO_BILLING_CHANNEL_ID=<live-billing-channel>
# Callbacks are refused without these. Use the secret, and the IP allowlist too
# once PayHero's callback source addresses are confirmed.
PAYHERO_WEBHOOK_SECRET=<openssl-rand-hex-32>
PAYHERO_WEBHOOK_IPS=
PAYHERO_CALLBACK_BASE_URL=https://api.willcoll.app

# Rotating this signs every tenant out of the pay page (their codes and
# sessions become invalid), which is safe: they simply verify again.
PAY_SESSION_SECRET=<openssl-rand-hex-32>
PAY_OTP_TTL=5m
PAY_SESSION_TTL=15m
PAY_INTENT_TTL=10m

AFRICASTALKING_API_KEY=<africastalking-live-api-key>
AFRICASTALKING_USERNAME=<africastalking-username>

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_SENDER=Willcoll <no-reply@willcoll.app>

FRONTEND_URL=https://app.willcoll.app
# Branded domain encoded in printed unit QR codes: stable for the life of the stickers.
# /q/* on this domain must be proxied to the API's /q/:token.
QR_BASE_URL=https://willcoll.app
# Free trial: days from account activation before a firm must buy a plan.
TRIAL_DAYS=7
# Enforce the trial and the subscription paywall. Keep true outside local experiments.
SUBSCRIPTION_GATE=true
CORS_TRUSTED_ORIGINS=https://app.willcoll.app

SESSION_LIFETIME=12h
SESSION_IDLE_TIMEOUT=2h
SESSION_SECURE=true

# Caddy's address: only its X-Forwarded-For is believed, so rate limiting and
# webhook IP checks see real client addresses and cannot be spoofed.
TRUSTED_PROXIES=<caddy-ip-or-cidr>
