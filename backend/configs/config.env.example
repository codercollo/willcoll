PORT=4000
# Internal-only /debug/vars listener (expvar). Empty = off. Never publish or proxy it:
# bind loopback in dev, the container network in staging/production.
# METRICS_ADDR=127.0.0.1:9000
ENV=development

# postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
# Password special characters must be URL-encoded (@ -> %40).
# API runtime role: NOSUPERUSER, NOBYPASSRLS, so tenant RLS policies apply.
DB_DSN=postgres://willcoll_app:<app-password>@localhost:5432/willcoll?sslmode=disable
# Migration/owner role. Never point the API at this: superusers bypass RLS.
MIGRATE_DSN=postgres://willcoll:<owner-password>@localhost:5432/willcoll?sslmode=disable
# Applied to the runtime roles by `make db/roles`; DB_APP_PASSWORD must
# match the password in DB_DSN.
DB_APP_PASSWORD=<app-password>
DB_ADMIN_PASSWORD=<admin-password>
# willcoll_admin (BYPASSRLS) connection, used only by /v1/admin/*. Leave
# empty to derive it from DB_DSN with the willcoll_admin role and
# DB_ADMIN_PASSWORD.
DB_ADMIN_DSN=

# willcoll_platform (build-phases.txt 3i-b). REQUIRED by rentals-api in every
# environment: it has no identity tables of its own, so every session, manager,
# staff member, entitlement gate and usage report is read from here.
# PLATFORM_DB_DSN is the willcoll_platform_app role (subject to RLS); the admin
# DSN is willcoll_platform_admin (BYPASSRLS), derived from PLATFORM_DB_DSN and
# PLATFORM_DB_ADMIN_PASSWORD when left empty. platform-api uses the same pair
# (as DB_DSN / DB_ADMIN_DSN in its own environment).
PLATFORM_DB_DSN=postgres://willcoll_platform_app:<platform-app-password>@localhost:5432/willcoll_platform?sslmode=disable
PLATFORM_DB_ADMIN_DSN=
PLATFORM_DB_ADMIN_PASSWORD=<platform-admin-password>
# cmd/devtools and cmd/seed (development only): willcoll_platform_admin DSN,
# and for `make db/seed ARGS=-reset` the willcoll_platform owner DSN.
PLATFORM_DSN=
PLATFORM_MIGRATE_DSN=

# platform-api only: the Super Admin system health page asks each product API
# for its own report. RENTALS_API_URL is rentals-api internal base URL (empty:
# reported as "not configured"); HEALTH_TIMEOUT bounds each check so one dead
# service never holds the page up. rentals-api reads HEALTH_TIMEOUT too, for
# its own database checks on that report (default 5s).
RENTALS_API_URL=
HEALTH_TIMEOUT=5s

# platform-api only (rentals-api no longer reads these): the single Super
# Admin, provisioned into the admins table at startup and used at POST
# /v1/admin/sessions. Changing ADMIN_PASSWORD and restarting rotates it.
# Password: 12-72 bytes. Without ADMIN_EMAIL, admin login is off.
ADMIN_NAME=Willcoll Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m
# Upper bound for each data-layer call (Go duration, e.g. 3s).
DB_QUERY_TIMEOUT=3s

LIMITER_RPS=2
LIMITER_BURST=4
LIMITER_ENABLED=true

PAYHERO_BASE_URL=
PAYHERO_API_KEY=
PAYHERO_COLLECTIONS_CHANNEL_ID=
PAYHERO_BILLING_CHANNEL_ID=
PAYHERO_ACCOUNT_ID=
# Callbacks are refused unless they pass what is set here: a secret carried as
# ?token= on the callback URL (or X-Webhook-Token), and/or a source-IP
# allowlist. Set at least one.
PAYHERO_WEBHOOK_SECRET=
PAYHERO_WEBHOOK_IPS=
# Product-to-platform service credential (platform-api, /internal/v1/*). Sent as
# `Authorization: Bearer <value>`; leave unset to refuse every service request.
# Generate with `openssl rand -hex 32`. To rotate: set the new value here and
# move the old one to SERVICE_TOKEN_PREVIOUS, roll the callers, then clear it.
# Never put it in a frontend or a URL.
SERVICE_TOKEN=
SERVICE_TOKEN_PREVIOUS=
# Public origin of this API, used to build the callback URL sent to PayHero.
PAYHERO_CALLBACK_BASE_URL=

# Signs pay-session tokens and hashes SMS codes for the public pay page
# (openssl rand -hex 32). Unset disables /v1/pay.
PAY_SESSION_SECRET=
PAY_OTP_TTL=5m
PAY_SESSION_TTL=15m
PAY_INTENT_TTL=10m

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=Willcoll <no-reply@willcoll.app>

# Frontend base URL for links in emails. platform-api: frontend/platform (the
# app that owns sign-in: activation, password reset, staff invite links), e.g.
# http://localhost:3001 or https://app.willcoll.co.ke. rentals-api: its own
# Rentals app. Each API reads its own copy of this variable.
FRONTEND_URL=http://localhost:3000
# Public, branded origin printed stickers point at: the QR encodes
# <QR_BASE_URL>/q/<token>, never the raw API origin, so stickers outlive
# infrastructure changes. Route /q/* on that domain to this API. Required to
# generate unit QR codes (unset = "not available"). For a phone scanning a local
# setup use your tunnel URL here AND in FRONTEND_URL, since the scan redirects
# to the pay page on FRONTEND_URL.
QR_BASE_URL=
# Free trial: days from account activation before a firm must buy a plan.
TRIAL_DAYS=7
# Enforce the trial and the subscription paywall. Keep true outside local experiments.
SUBSCRIPTION_GATE=true

# Every Willcoll app origin, space separated, e.g. http://localhost:3000 http://localhost:3001
# (the frontend proxies the API same-origin, so this only matters for a
# direct browser-to-API setup).
CORS_TRUSTED_ORIGINS=
# platform-api only. The shared session cookie's Domain attribute so every app
# subdomain receives it: .willcoll.co.ke in production. Leave EMPTY locally:
# a host-only cookie on `localhost` is already shared by the apps' two ports.
SESSION_COOKIE_DOMAIN=

# SCS cookie session (Go durations). Sliding: activity renews a session (at
# most every SESSION_IDLE_TIMEOUT/4); SESSION_IDLE_TIMEOUT without activity,
# or SESSION_LIFETIME since login (absolute cap, never extended), ends it.
# Platform-api and every product API must use the same two values.
# SESSION_SECURE defaults to true unless ENV=development.
SESSION_LIFETIME=12h
SESSION_IDLE_TIMEOUT=2h
SESSION_SECURE=

# Reverse proxies (Caddy) trusted for X-Forwarded-For, space separated.
# Leave empty when the API is reached directly.
TRUSTED_PROXIES=
