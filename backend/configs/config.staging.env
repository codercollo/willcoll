# Staging: a copy of production's shape with test credentials (PayHero and
# Africa's Talking sandboxes). COMMITTED WITH PLACEHOLDERS ONLY. The real file
# lives on the staging VPS (and its values in CI secrets); this one is the
# checklist of what must be set. Angle-bracket values are placeholders.
#
# Anything empty falls back to the default in cmd/api/config.go. The API logs a
# warning at startup for every payment setting that is missing.

PORT=4000
ENV=staging

DB_DSN=postgres://willcoll_app:<app-password>@db:5432/willcoll?sslmode=require
MIGRATE_DSN=postgres://willcoll:<owner-password>@db:5432/willcoll?sslmode=require
DB_APP_PASSWORD=<app-password>
DB_ADMIN_PASSWORD=<admin-password>
DB_ADMIN_DSN=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m
DB_QUERY_TIMEOUT=3s

ADMIN_NAME=Willcoll Admin (staging)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password-12-to-72-bytes>

LIMITER_RPS=2
LIMITER_BURST=4
LIMITER_ENABLED=true

# PayHero sandbox account.
PAYHERO_BASE_URL=<payhero-base-url>
PAYHERO_API_KEY=<payhero-authorization-header-value>
PAYHERO_COLLECTIONS_CHANNEL_ID=<sandbox-collections-channel>
PAYHERO_BILLING_CHANNEL_ID=<sandbox-billing-channel>
PAYHERO_WEBHOOK_SECRET=<openssl-rand-hex-32>
PAYHERO_WEBHOOK_IPS=
PAYHERO_CALLBACK_BASE_URL=https://api.staging.willcoll.app

PAY_SESSION_SECRET=<openssl-rand-hex-32>
PAY_OTP_TTL=5m
PAY_SESSION_TTL=15m
PAY_INTENT_TTL=10m

# Africa's Talking sandbox: the username "sandbox" selects the sandbox API.
AFRICASTALKING_API_KEY=<africastalking-sandbox-api-key>
AFRICASTALKING_USERNAME=sandbox

SMTP_HOST=<smtp-host>
SMTP_PORT=2525
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_SENDER=Willcoll Staging <no-reply@staging.willcoll.app>

FRONTEND_URL=https://staging.willcoll.app
# Branded domain encoded in unit QR codes; /q/* must reach this API.
QR_BASE_URL=https://staging.willcoll.app
# Free trial: days from account activation before a firm must buy a plan.
TRIAL_DAYS=7
# Enforce the trial and the subscription paywall. Keep true outside local experiments.
SUBSCRIPTION_GATE=true
CORS_TRUSTED_ORIGINS=https://staging.willcoll.app

SESSION_LIFETIME=12h
SESSION_IDLE_TIMEOUT=2h
SESSION_SECURE=true

# The Caddy container's address on the compose network.
TRUSTED_PROXIES=<caddy-ip-or-cidr>
