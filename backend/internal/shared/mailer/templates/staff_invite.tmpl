{{/*
  Staff invite email (build-phases.txt 3f-1). Sent when an owner invites a
  staff member (POST /v1/staff).

  Data: FirmName, StaffName, Role, ActivationURL, ActivationToken, ExpiresIn.

  Same visual pattern as manager_welcome.tmpl (design-tokens.txt).
*/}}

{{define "subject"}}You've been invited to Willcoll{{end}}

{{define "plainBody"}}
Hi {{.StaffName}},

{{.FirmName}} has invited you to their Willcoll account as {{.Role}}. Set your password to activate your account:

{{.ActivationURL}}

Or enter this activation code on the activation page:
{{.ActivationToken}}

This code can only be used once and expires in {{.ExpiresIn}}.

If you weren't expecting this invitation, you can ignore this email.

— The Willcoll team
{{end}}

{{define "htmlBody"}}
<!doctype html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>You've been invited to Willcoll</title>
</head>
<body style="margin:0;padding:0;background-color:#F1F3F6;font-family:'Inter',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F3F6;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">

          <tr>
            <td style="background-color:#0B1220;border-radius:10px 10px 0 0;padding:20px 24px;">
              <span style="font-size:18px;line-height:26px;font-weight:700;letter-spacing:-0.01em;color:#FFFFFF;">Willcoll</span>
            </td>
          </tr>

          <tr>
            <td style="background-color:#FFFFFF;border:1px solid #D7DCE3;border-top:0;border-radius:0 0 10px 10px;padding:24px;">
              <h1 style="margin:0 0 16px;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.01em;color:#111827;">You've been invited</h1>

              <p style="margin:0 0 16px;font-size:14px;line-height:20px;color:#374151;">Hi {{.StaffName}},</p>
              <p style="margin:0 0 24px;font-size:14px;line-height:20px;color:#374151;"><strong style="font-weight:600;color:#111827;">{{.FirmName}}</strong> has invited you to their Willcoll account as <strong style="font-weight:600;color:#111827;">{{.Role}}</strong>. Set your password to activate your account.</p>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
                <tr>
                  <td style="background-color:#2F6FED;border-radius:6px;">
                    <a href="{{.ActivationURL}}" style="display:inline-block;padding:10px 20px;font-size:14px;line-height:20px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:6px;">Set password</a>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 8px;font-size:13px;line-height:18px;font-weight:500;letter-spacing:0.02em;text-transform:uppercase;color:#6B7280;">Or enter this activation code</p>
              <p style="margin:0 0 24px;padding:12px 16px;background-color:#F2F6FF;border:1px solid #D7DCE3;border-radius:6px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:15px;line-height:22px;font-weight:600;letter-spacing:0.04em;color:#111827;">{{.ActivationToken}}</p>

              <p style="margin:0;font-size:12px;line-height:16px;color:#6B7280;">This code can only be used once and expires in {{.ExpiresIn}}. If you weren't expecting this invitation, you can ignore this email.</p>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:16px 24px 0;font-size:12px;line-height:16px;color:#6B7280;">Willcoll · Property &amp; rent reconciliation</td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{{end}}
