# Local development settings for BOTH APIs. Copy to backend/.env (git-ignored)
# and edit the lines marked EDIT. Every other value works as written for a
# local stack: `make dev/setup` then `make dev/up` (docs/dev-setup.md).
#
# How the dev stack uses this file: scripts/lib_dev.sh derives the databases'
# DSNs itself from MIGRATE_DSN + the role passwords below, for the DEV_* databases.
# It reads only the willcoll_app password (DB_APP_PASSWORD, else the one in DB_DSN)
# and never connects to the database DB_DSN names, so an existing database there is left alone. The DSN
# variables are still listed because the integration tests (make test/integration)
# and a binary started by hand read them.
# Passwords: letters, digits, - _ . only (they are placed into DSNs as written).

# ---------------------------------------------------------------- environment
ENV=development
# rentals-api listens here; platform-api on PLATFORM_PORT.
PORT=4000
PLATFORM_PORT=4100

# ------------------------------------------------------------------ databases
# EDIT: a SUPERUSER on your local Postgres (it creates roles/databases, runs
# migrations). Only host, port, user and password matter; the database name in it
# is ignored by the dev stack (the integration tests want it to be "willcoll").
MIGRATE_DSN=postgres://postgres:CHANGE-ME@localhost:5432/willcoll?sslmode=disable
# Dev stack databases. Created by dev/setup if missing.
DEV_RENTALS_DB=willcoll_rentals
DEV_PLATFORM_DB=willcoll_platform

# Runtime roles (dev/setup creates any that are missing, with these passwords).
# rentals: willcoll_app (subject to RLS) / willcoll_admin (BYPASSRLS, /v1/admin only).
DB_DSN=postgres://willcoll_app:willcoll-dev-app@localhost:5432/willcoll?sslmode=disable
DB_ADMIN_PASSWORD=willcoll-dev-admin
DB_ADMIN_DSN=
DB_APP_PASSWORD=willcoll-dev-app
# platform: willcoll_platform_app / willcoll_platform_admin. Leave unset to use
# the throwaway "willcoll-test-<role>" passwords the integration-test scripts use.
PLATFORM_DB_APP_PASSWORD=
PLATFORM_DB_ADMIN_PASSWORD=
# rentals-api's connection to willcoll_platform (the dev stack sets these itself;
# needed when you start a binary by hand). Blank admin DSN = derived.
PLATFORM_DB_DSN=
PLATFORM_DB_ADMIN_DSN=
# cmd/devtools and cmd/seed (the dev tooling derives these; set for manual runs).
PLATFORM_DSN=
PLATFORM_MIGRATE_DSN=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m
DB_QUERY_TIMEOUT=3s

# --------------------------------------------------------------- Super Admin
# platform-api provisions this account at startup (and dev/setup seeds it).
# EDIT: a password of 12-72 characters. Without ADMIN_EMAIL admin login is off.
ADMIN_NAME=Willcoll Admin
ADMIN_EMAIL=admin@willcoll.test
ADMIN_PASSWORD=CHANGE-ME-12-chars-min

# ------------------------------------------------------------ sessions / CORS
# The session cookie is host-only on localhost: SESSION_COOKIE_DOMAIN stays
# empty. The cookie is named "willcoll_session" (fixed in code; platform-api
# sets it, rentals-api reads it) and travels through the frontend's same-origin
# proxies, so no cross-origin cookie setup is needed.
SESSION_COOKIE_DOMAIN=
SESSION_SECURE=false
SESSION_LIFETIME=12h
SESSION_IDLE_TIMEOUT=2h
# The Nuxt app origin(s), space separated.
CORS_TRUSTED_ORIGINS=http://localhost:3000
# Links in activation / password-reset emails (the rentals frontend hosts the pages).
FRONTEND_URL=http://localhost:3000
TRUSTED_PROXIES=

# Rate limiting: off in dev (the frontend makes bursts of calls).
LIMITER_ENABLED=false
LIMITER_RPS=2
LIMITER_BURST=4

# ---------------------------------------------------------------------- email
# Blank SMTP_HOST = log mailer: activation, invite and reset links are written to
# platform-api's log (bin/dev-logs/platform-api.log under `make dev/up`).
SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=Willcoll <no-reply@willcoll.test>

# ------------------------------------------------------- PayHero / SMS (fake)
# With DEV_FAKES=true (default), `make dev/up` starts local stand-ins for
# Africa's Talking and PayHero and points both APIs at them, overriding the
# PAYHERO_* / AFRICASTALKING_* / SMTP_HOST values below for those processes
# only. SMS codes are written to rentals-api's log and the stand-in's log. Set
# DEV_FAKES=false to use the real services with the values below.
DEV_FAKES=true
FAKE_SMS_ADDR=127.0.0.1:14901
FAKE_PAYHERO_ADDR=127.0.0.1:14902
PAYHERO_BASE_URL=
PAYHERO_API_KEY=
PAYHERO_COLLECTIONS_CHANNEL_ID=
PAYHERO_BILLING_CHANNEL_ID=
PAYHERO_ACCOUNT_ID=
# Callbacks are refused unless they carry this as ?token= / X-Webhook-Token.
PAYHERO_WEBHOOK_SECRET=dev-webhook-secret
PAYHERO_WEBHOOK_IPS=
# Public origin PayHero calls back (a tunnel URL when using the real PayHero).
PAYHERO_CALLBACK_BASE_URL=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_BASE_URL=

# ---------------------------------------------------------------- pay page / QR
# Signs pay-session tokens and hashes SMS codes (openssl rand -hex 32).
PAY_SESSION_SECRET=dev-pay-session-secret-0123456789abcdef
PAY_OTP_TTL=5m
PAY_SESSION_TTL=15m
PAY_INTENT_TTL=10m
# Public origin printed on QR stickers; for a phone scanning a local setup use
# your LAN IP or tunnel URL (and the same in FRONTEND_URL).
QR_BASE_URL=http://localhost:3000

# --------------------------------------------------------- trial / subscription
TRIAL_DAYS=7
SUBSCRIPTION_GATE=true
