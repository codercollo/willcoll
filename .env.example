# --- PostgreSQL DSN pieces ---
# Hostname of the Postgres server (the compose service name in dev)
POSTGRES_HOST=
# Postgres port
POSTGRES_PORT=
# Postgres user the API connects as
POSTGRES_USER=
# Postgres password — set a real value in .env
POSTGRES_PASSWORD=
# Database name
POSTGRES_DB=
# TLS mode for the connection (disable in dev, require in production)
POSTGRES_SSLMODE=

# pgxpool tuning (LGF §5.3)
# Max connections in the pool (pool size)
DATABASE_MAX_CONNS=
# Max time a connection may sit idle
DATABASE_MAX_CONN_IDLE_TIME=
# Max lifetime of a connection
DATABASE_MAX_CONN_LIFETIME=

# --- Auth ---
# Symmetric key for PASETO v2.local token signing/encryption
PASETO_SYMMETRIC_KEY=

# --- SMTP / Mailtrap ---
# SMTP server host (Mailtrap sandbox in dev/staging, a real provider in production)
SMTP_HOST=
# SMTP port
SMTP_PORT=
# SMTP username
SMTP_USERNAME=
# SMTP password
SMTP_PASSWORD=
# From name/address used on outbound email
SMTP_SENDER=

# --- SMS gateway ---
# Provider API key (vendor TBD — Africa's Talking or a bank-grade aggregator, spec §11.3)
SMS_API_KEY=
# Provider API secret, if the chosen vendor requires one
SMS_API_SECRET=
# Provider API base URL
SMS_GATEWAY_URL=
# Platform-default alphanumeric sender ID (fallback when an Organization has no own sender)
SMS_SENDER_ID=

# --- IntaSend payment gateway ---
# IntaSend publishable key (public, client-facing)
INTASEND_PUBLISHABLE_KEY=
# IntaSend secret key (server-only)
INTASEND_SECRET_KEY=
# IntaSend webhook signature secret
INTASEND_WEBHOOK_SECRET=
# IntaSend environment: sandbox in dev/staging, live only in production
INTASEND_ENVIRONMENT=

# --- Scoring (ml-sidecar) ---
# Base URL for the ml-sidecar FastAPI server-to-server call (spec §13.3)
SIDECAR_BASE_URL=
# Shared secret for internal Go -> FastAPI HTTP calls
SIDECAR_SHARED_SECRET=

# --- Branding ---
# Filesystem path where Organization logo uploads are stored
LOGO_STORAGE_PATH=

# --- Serving ---
# API server listen address (host:port); default ":4000"
SERVER_ADDR=
# Public domain served by Caddy (e.g. localhost in dev)
WILLCOLL_DOMAIN=
# Frontend dev server port that Caddy proxies non-API traffic to
WEB_PORT=

# --- Backups (pg_backup / WAL) ---
# GPG passphrase for optional encrypted pg_dump backups (empty = unencrypted)
BACKUP_GPG_PASSPHRASE=
# Optional offsite upload endpoint (curl -T target); empty = offsite push disabled
BACKUP_OFFSITE_URL=
# Number of nightly dumps to retain before pruning
BACKUP_RETENTION_DAYS=
# Directory for continuous WAL archive segments
WAL_ARCHIVE_PATH=
