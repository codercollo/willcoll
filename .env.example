# --- PostgreSQL ---
# These configure the `postgres` container itself (build/docker-compose.yml)
# — Postgres only applies them on the FIRST init of an empty volume; editing
# them later does nothing until you `make reset-dev` (drops the volume).
POSTGRES_HOST=postgres
# 5433, not 5432 — leaves room for a native Postgres install that may
# already own 5432 on the host (see README.md).
POSTGRES_PORT=5433
POSTGRES_USER=willcoll
POSTGRES_PASSWORD=willcoll
POSTGRES_DB=willcoll
POSTGRES_SSLMODE=disable

# DATABASE_DSN documents/overrides configs/config.example.yaml's database.dsn
# (internal/config binds it automatically when actually present in the
# process environment — a plain `go run` does NOT read .env itself, so for
# local dev the source of truth is configs/config.example.yaml's dsn value;
# keep the two in sync). It MUST differ between host and container:
#   - Running the Go server on the host (`go run ./cmd/willcoll`, normal dev):
#     postgres://willcoll:willcoll@localhost:5433/willcoll?sslmode=disable
#   - Running the Go server itself inside Compose (prod-style):
#     postgres://willcoll:willcoll@postgres:5432/willcoll?sslmode=disable
# "postgres" only resolves inside the Compose network; the host only sees it
# via the published port on localhost.
DATABASE_DSN=postgres://willcoll:willcoll@localhost:5433/willcoll?sslmode=disable

# pgxpool tuning (LGF §5.3)
# Max connections in the pool (pool size)
DATABASE_MAX_CONNS=
# Max time a connection may sit idle
DATABASE_MAX_CONN_IDLE_TIME=
# Max lifetime of a connection
DATABASE_MAX_CONN_LIFETIME=

# --- Auth ---
# Symmetric key for PASETO v2.local token signing/encryption
PASETO_SYMMETRIC_KEY=

# --- SMTP / Mailtrap ---
# SMTP server host (Mailtrap sandbox in dev/staging, a real provider in production)
SMTP_HOST=
# SMTP port
SMTP_PORT=
# SMTP username
SMTP_USERNAME=
# SMTP password
SMTP_PASSWORD=
# From name/address used on outbound email
SMTP_SENDER=

# --- SMS gateway ---
# Provider API key (vendor TBD — Africa's Talking or a bank-grade aggregator, spec §11.3)
SMS_API_KEY=
# Provider API secret, if the chosen vendor requires one
SMS_API_SECRET=
# Provider API base URL
SMS_GATEWAY_URL=
# Platform-default alphanumeric sender ID (fallback when an Organization has no own sender)
SMS_SENDER_ID=

# --- IntaSend payment gateway ---
# IntaSend publishable key (public, client-facing)
INTASEND_PUBLISHABLE_KEY=
# IntaSend secret key (server-only)
INTASEND_SECRET_KEY=
# IntaSend webhook signature secret
INTASEND_WEBHOOK_SECRET=
# IntaSend environment: sandbox in dev/staging, live only in production
INTASEND_ENVIRONMENT=

# --- Scoring (ml-sidecar) ---
# Base URL for the ml-sidecar FastAPI server-to-server call (spec §13.3)
SIDECAR_BASE_URL=
# Shared secret for internal Go -> FastAPI HTTP calls
SIDECAR_SHARED_SECRET=

# --- Branding ---
# Filesystem path where Organization logo uploads are stored
LOGO_STORAGE_PATH=

# --- Serving ---
# API server listen address (host:port); default ":4000"
SERVER_ADDR=
# Public domain served by Caddy (e.g. localhost in dev)
WILLCOLL_DOMAIN=
# Frontend dev server port that Caddy proxies non-API traffic to
WEB_PORT=

# --- Platform admin panel (cmd/willcoll-admin, spec Phase 23) ---
# Separate binary, separate DSN — connects as the platform_admin_panel
# Postgres role (migration 000019, BYPASSRLS), never internal/api's own DSN/pool.
ADMIN_DATABASE_DSN=
# Single hardcoded operator username (spec §23.1) — not a row in `users`.
ADMIN_USERNAME=
# bcrypt hash of the operator's password. Generate once (e.g. `htpasswd -bnBC 10 "" 'yourpassword' | cut -d: -f2`
# or Go's bcrypt.GenerateFromPassword) — NEVER put the plaintext password here.
ADMIN_PASSWORD_HASH=
# Admin panel HTTP listen address; default ":4100"
ADMIN_LISTEN_ADDR=

# --- Backups (pg_backup / WAL) ---
# GPG passphrase for optional encrypted pg_dump backups (empty = unencrypted)
BACKUP_GPG_PASSPHRASE=
# Optional offsite upload endpoint (curl -T target); empty = offsite push disabled
BACKUP_OFFSITE_URL=
# Number of nightly dumps to retain before pruning
BACKUP_RETENTION_DAYS=
# Directory for continuous WAL archive segments
WAL_ARCHIVE_PATH=
