# Multi-stage/multi-target (spec §7): base -> dev (nuxt dev server, HMR) ->
# builder (nuxt generate) -> prod (nginx serving the static export).
# Build context is the repo root (needed for nginx.conf + ../api/openapi.yaml
# generate:api resolves against), e.g.:
#   docker build -f build/package/Dockerfile.web --target dev .

FROM node:22-alpine AS base
WORKDIR /repo/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN CI=true pnpm install --frozen-lockfile
COPY api/openapi.yaml /repo/api/openapi.yaml

FROM base AS dev
COPY web/. .
EXPOSE 3000
CMD ["pnpm", "dev", "--", "--host"]

FROM base AS builder
COPY web/. .
RUN pnpm run generate:api && pnpm run generate

FROM nginx:1.27-alpine AS prod
COPY --from=builder /repo/web/.output/public /srv/web
COPY build/package/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
