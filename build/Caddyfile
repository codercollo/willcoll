{$WILLCOLL_DOMAIN:localhost} {
	# API traffic goes to the api container; everything else goes to the web
	# container, which is nginx serving the Nuxt static export with its own
	# SPA-fallback try_files (build/package/nginx.conf — nuxt.config.ts's
	# static preset emits 200.html specifically so a multi-tenant path like
	# /{slug}/login resolves client-side even though no build-time crawler
	# can ever enumerate every Organization's slug). Service names, not
	# localhost — Caddy, api, and web are separate containers in prod (2.2).
	handle /v1/* {
		reverse_proxy api:4000
	}
	handle /healthz {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:80
	}

	encode gzip
}
